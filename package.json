{
  "name": "pivotprime",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/lint-copy.mjs && node scripts/lint-palette.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:palette": "node scripts/lint-palette.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check": "node scripts/check-overflow.mjs && node scripts/check-content.mjs && node scripts/check-links.mjs && node scripts/check-behaviour.mjs && node scripts/check-unsanctioned-copy.mjs && npm run --silent report",
    "check:links": "node scripts/check-links.mjs",
    "check:behaviour": "node scripts/check-behaviour.mjs",
    "check:copy-reverse": "node scripts/check-unsanctioned-copy.mjs",
    "check:dropped": "node scripts/check-dropped-mockup-copy.mjs",
    "report": "node scripts/audit-spec-copy.mjs && node scripts/check-dropped-mockup-copy.mjs",
    "audit:copy": "node scripts/audit-spec-copy.mjs"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
